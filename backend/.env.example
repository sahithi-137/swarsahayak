# SwarSahayak Backend Environment Configuration
PORT=8000
ENVIRONMENT=development

# Speech Synthesis Providers
# 1. Edge Neural TTS: Active by default out-of-the-box (zero API keys needed)
# 2. Server gTTS: Active fallback for additional Indian languages
# 3. Native Speaker Recordings: Stored in app/data/recordings/ with recordings_manifest.json

# Optional: Bhashini (National Language Translation Mission / ULCA) Production Credentials
# If provided, requests for scheduled languages will route through Bhashini Dhruva endpoints
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference

